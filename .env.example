# Skopiuj do .env i dostosuj wartości.
# Docker Compose ładuje .env z katalogu obok docker-compose.yml.

# Baza danych
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=botland
MYSQL_USER=ps
MYSQL_PASSWORD=ps

# PrestaShop
PS_DOMAIN=localhost
PS_FOLDER_ADMIN=admin-dev
PS_COUNTRY=pl
PS_LANGUAGE=pl
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=User
ADMIN_EMAIL=admin@prestashop.local
ADMIN_PASSWD=admin12345

# Porty (host)
PORT_HTTP=8888
PORT_MYSQL=3307
